{
  "name": "dms-agent",
  "version": "0.1.0",
  "description": "Dead Man's Switch monitoring agent + Telegram bot",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run",
    "e2e:devnet": "tsc && node dist/scripts/e2e-devnet.js",
    "postinstall": "cd node_modules/@3land/listings-sdk/node_modules && rm -rf node-fetch && npm install node-fetch@2.7.0 --no-save 2>/dev/null || true"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/web3.js": "^1.95.0",
    "@supabase/supabase-js": "^2.45.0",
    "bn.js": "^5.2.1",
    "bs58": "^5.0.0",
    "dotenv": "^16.4.5",
    "nodemailer": "^6.9.14",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "solana-agent-kit": "^1.0.0",
    "telegraf": "^4.16.3",
    "zod": "^3.23.8"
  },
"overrides": {
    "jito-ts": {
      "rpc-websockets": "7.5.1"
    },
    "@wormhole-foundation/sdk-solana": {
      "rpc-websockets": "7.5.1"
    },
    "node-fetch": "2.7.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.5",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.5.4",
    "vitest": "^1.6.1"
  }
}
